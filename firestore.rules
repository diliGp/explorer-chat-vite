rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Feature Flags (read-only for all signed-in users) ─────────────────────
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // manage via Firebase console only
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'name', 'age', 'gender', 'country', 'isPermanent', 'isOnline', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.age is number
        && request.resource.data.age >= 13
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      // Allow users to delete their own profile (anon cleanup)
      allow delete: if isOwner(uid);
    }

    // ── DMs ───────────────────────────────────────────────────────────────────
    match /dms/{dmId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      function isParticipantInNew() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isParticipant();

      allow create: if isParticipantInNew()
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasAll(['participants', 'participantNames', 'createdAt', 'lastMessageAt'])
        && dmId == [request.resource.data.participants[0], request.resource.data.participants[1]].join('_');

      allow update: if isParticipant() && (
          (request.resource.data.participants == resource.data.participants)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bothReplied'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedBy'])
        );

      // Allow participants to delete the DM (anon user cleanup)
      allow delete: if isParticipant();

      // ── Messages sub-collection ─────────────────────────────────────────────
      match /messages/{msgId} {
        function isDmParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants;
        }

        function isNotBlocked() {
          // Block message create if the sender is in the DM's blockedBy list
          // (i.e., the other party has blocked them, or they've blocked the other party)
          let dmData = get(/databases/$(database)/documents/dms/$(dmId)).data;
          return !(request.auth.uid in (dmData.get('blockedBy', [])));
        }

        allow read: if isDmParticipant();

        allow create: if isDmParticipant()
          && isNotBlocked()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.dmId == dmId
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'type', 'createdAt', 'dmId'])
          && request.resource.data.type in ['text', 'image', 'gif'];

        allow update: if isDmParticipant()
          && (
            (request.auth.uid == resource.data.senderId)
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['mediaViewed', 'mediaRef', 'reportedBy'])
          )
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.dmId == resource.data.dmId
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isDmParticipant();
      }
    }
  }
}
