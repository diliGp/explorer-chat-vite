rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function senderIsPermanent() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPermanent == true;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'name', 'age', 'gender', 'country', 'isPermanent', 'isOnline', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.age is int
        && request.resource.data.age >= 13
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ── DMs ───────────────────────────────────────────────────────────────────
    match /dms/{dmId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      function isParticipantInNew() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isParticipant();

      allow create: if isParticipantInNew()
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasAll(['participants', 'participantNames', 'createdAt', 'lastMessageAt'])
        && dmId == [request.resource.data.participants[0], request.resource.data.participants[1]].join('_');

      // Participants can update DM metadata (lastMessageAt, lastMessagePreview,
      // lastSenderId, consecutiveSenderCount, unreadCount) but not participants list
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants;

      // ── Messages sub-collection ─────────────────────────────────────────────
      match /messages/{msgId} {
        function isDmParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants;
        }

        function canSend() {
          let dm = get(/databases/$(database)/documents/dms/$(dmId)).data;
          let lastSender = dm.get('lastSenderId', '');
          let count = dm.get('consecutiveSenderCount', 0);
          // Permanent users are never rate-limited
          return senderIsPermanent()
            || lastSender != request.auth.uid
            || count < 2;
        }

        allow read: if isDmParticipant();

        allow create: if isDmParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.dmId == dmId
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'type', 'createdAt', 'dmId'])
          && request.resource.data.type in ['text', 'image', 'gif']
          && canSend();

        allow update: if isDmParticipant()
          && (
            (request.auth.uid == resource.data.senderId)
            || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['mediaViewed', 'mediaRef', 'reportedBy'])
          )
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.dmId == resource.data.dmId
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isDmParticipant();
      }
    }
  }
}
